<Window x:Class="FDistractions.App.Overlays.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="F Distractions"
        Width="600" Height="400"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Opacity="0">
    <Border Margin="14" CornerRadius="24" Background="{StaticResource CanvasBrush}"
            BorderBrush="#A6FFFFFF" BorderThickness="1" Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="/Assets/icon.png" Width="30" Height="30" />
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="F DISTRACTIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="ScreenLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="9" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="WHY THIS SCREEN WAS BLURRED" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="ReasonText" Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="124"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="13" CornerRadius="10" Background="#09171A1A">
                <StackPanel>
                    <TextBlock Text="Your focus" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="GoalText" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="36" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Button x:Name="ReturnButton" Grid.Row="4" Style="{StaticResource PrimaryButton}" Height="44"
                    Click="OnReturnClick" Content="Return to work  ↗" />

            <TextBlock Grid.Row="5" Margin="0,12,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"
                       Text="3 seconds to switch. Then we check again." />
        </Grid>
    </Border>
</Window>
