<Window x:Class="FDistractions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FDistractions.App.Controls"
        Title="F Distractions" Icon="/Assets/icon.png"
        Width="560" Height="760" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">

            <DockPanel>
                <Image Source="/Assets/icon.png" Width="36" Height="36" DockPanel.Dock="Left" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="F Distractions" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Windows prototype" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="NoticeText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />

            <!-- Before a session -->
            <StackPanel x:Name="SetupPanel">
                <TextBlock Style="{StaticResource FieldLabel}" Text="What are you working on?" />
                <TextBox x:Name="GoalBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Padding="8"
                         FontSize="13" VerticalScrollBarVisibility="Auto" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Session length (minutes)" />
                        <TextBox x:Name="MinutesBox" Text="45" Padding="6" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Check every" />
                        <ComboBox x:Name="GapBox" FontSize="13" Padding="6" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,18,0,0" Padding="14" CornerRadius="10" Background="#0D171A1A">
                    <StackPanel>
                        <TextBlock Text="Assessment" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProviderBox" Margin="0,8,0,0" FontSize="13" Padding="6" SelectionChanged="OnProviderChanged" />

                        <StackPanel x:Name="ClaudePanel">
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Text="Runs your own Claude Code install with all tools switched off. Your screenshots are sent to Anthropic for each check and count towards your Claude plan's usage limits. F Distractions never sees your Claude password or tokens." />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Model" />
                            <ComboBox x:Name="ModelBox" FontSize="13" Padding="6" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Height="30" Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                        Content="Check again" Click="OnCheckClaudeClick" />
                                <TextBlock x:Name="ClaudeStatusText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="TestPanel" Visibility="Collapsed">
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Text="The test classifier does not use AI: it never looks at your screenshots or sends them anywhere." />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Test classifier behaviour" />
                            <ComboBox x:Name="ClassifierBox" FontSize="13" Padding="6" SelectionChanged="OnClassifierChanged" />
                            <TextBlock x:Name="TargetLabel" Style="{StaticResource FieldLabel}" Text="Pretend this screen is off task" />
                            <ComboBox x:Name="TargetScreenBox" FontSize="13" Padding="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="StartButton" Margin="0,20,0,0" Height="44" Style="{StaticResource PrimaryButton}"
                        Content="Start focus session" Click="OnStartClick" />
                <TextBlock x:Name="SetupError" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- During a session -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Your focus" />
                <TextBlock x:Name="RunningGoal" TextWrapping="Wrap" FontSize="14" />

                <TextBlock x:Name="TimeText" Margin="0,18,0,0" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="StateText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#0D171A1A">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Latest check" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="CheckingText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="{StaticResource AccentBrush}" Text="Checking your screens…"
                                       Visibility="Hidden" />
                        </DockPanel>
                        <TextBlock x:Name="LastCheckText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" />
                        <StackPanel x:Name="ResultsList" Margin="0,6,0,0" />
                        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="CheckNowButton" Height="38" Margin="0,0,8,0" Style="{StaticResource QuietButton}"
                            Content="Check now" Click="OnCheckNowClick" />
                    <Button x:Name="ResumeButton" Height="38" Style="{StaticResource PrimaryButton}"
                            Content="Resume session" Click="OnResumeClick" Visibility="Collapsed" />
                </WrapPanel>

                <TextBlock Margin="0,18,0,6" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Text="Leaving early takes a continuous 10-second hold (mouse or Space). Releasing resets it. Your session keeps running while you hold." />
                <controls:HoldButton x:Name="PauseHold" Verb="pause" Margin="0,0,0,8" />
                <controls:HoldButton x:Name="EndHold" Verb="end session" />
                <TextBlock x:Name="QuitHint" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"
                           Text="To quit during a session, hold End session for 10 seconds first, then choose Quit from the tray icon." />
            </StackPanel>

            <Border Margin="0,22,0,0" Padding="14" CornerRadius="10" BorderBrush="#1F171A1A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Screens detected" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="DisplaysText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="CaptureWarning" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"
                               Text="Windows refused to hide the blur overlays from screenshots (needs Windows 10 version 2004 or later)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
